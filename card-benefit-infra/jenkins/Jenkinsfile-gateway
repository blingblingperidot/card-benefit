pipeline {
    agent any

    environment {
        SERVICE_DIR  = 'card-benefit-gateway-server'
        JAR_NAME     = 'card-benefit-gateway-server-0.0.1-SNAPSHOT.jar'
        JAR_PATH     = "${SERVICE_DIR}/target/${JAR_NAME}"
        BACKUP_DIR   = '/var/jenkins_home/backup'
        BACKUP_PATH  = "${BACKUP_DIR}/gateway-server.jar"
        PORT         = '8080'
        LOG_PATH     = "${BACKUP_DIR}/logs/gateway-server.log"
    }

    stages {
        stage('Check Changes') {
            steps {
                script {
                    def changes = sh(
                        script: "git diff --name-only HEAD~1 HEAD | grep ${SERVICE_DIR} || true",
                        returnStdout: true
                    ).trim()
                    if (changes.isEmpty()) {
                        currentBuild.result = 'NOT_BUILT'
                        error("${SERVICE_DIR} 변경사항 없음 - 빌드 스킵")
                    }
                    echo "변경사항 감지: ${changes}"
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    sh "mkdir -p ${BACKUP_DIR}/logs"
                    sh "cp -f ${JAR_PATH} ${BACKUP_PATH} || true"
                    sh """
                        PID=\$(lsof -ti:${PORT}) || true
                        if [ ! -z "\$PID" ]; then kill -9 \$PID; fi
                    """
                    sleep(3)
                    sh "nohup java -jar ${JAR_PATH} > ${LOG_PATH} 2>&1 &"
                    echo "배포 완료!"
                }
            }
        }
    }

    post {
        failure {
            script {
                echo "빌드 실패 - 이전 버전으로 롤백"
                sh """
                    PID=\$(lsof -ti:${PORT}) || true
                    if [ ! -z "\$PID" ]; then kill -9 \$PID; fi
                """
                sleep(3)
                sh "nohup java -jar ${BACKUP_PATH} > ${LOG_PATH} 2>&1 &"
            }
            slackSend(
                channel: '#jenkins-build',
                color: 'danger',
                message: "❌ [${env.SERVICE_DIR}] 빌드 실패 & 롤백\n브랜치: ${env.GIT_BRANCH}\n빌드: ${env.BUILD_NUMBER}\n${env.BUILD_URL}"
            )
        }
        success {
            slackSend(
                channel: '#jenkins-build',
                color: 'good',
                message: "✅ [${env.SERVICE_DIR}] 빌드 & 배포 성공\n브랜치: ${env.GIT_BRANCH}\n빌드: ${env.BUILD_NUMBER}\n${env.BUILD_URL}"
            )
        }
        aborted {
            slackSend(
                channel: '#jenkins-build',
                color: 'warning',
                message: "⏭️ [${env.SERVICE_DIR}] 변경사항 없음 - 빌드 스킵\n브랜치: ${env.GIT_BRANCH}"
            )
        }
    }
}